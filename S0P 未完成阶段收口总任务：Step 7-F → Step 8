"""Step 8 — L1 RawSource layer: Parser 输出结构（Coding Contract §5）。

铁律：Parsing ≠ Semantic Interpretation。
本模块只定义「有位置、有原始值、无语义」的单元格记录与解析结果容器。
不做：scope_class / fact_type / 实例 key / 单位 / 字段同义 的任何推断。
"""
from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, List, Optional

from cdm.types import RawSource

def raw_text_of(value: Any) -> str:
    """将 openpyxl 原始值确定性转为字符串（用于显示/记录，不做格式化策略）。"""
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    # datetime / date / time 等：ISO 8601 字符串（确定性）
    iso = getattr(value, "isoformat", None)
    if callable(iso):
        return iso()
    return str(value)
```

