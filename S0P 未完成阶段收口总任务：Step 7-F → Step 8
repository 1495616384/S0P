def _analyze_header(sheet_cells, explicit_header_row):
    by_row: dict[int, list[CellRaw]] = {}
    for c in sheet_cells:
        by_row.setdefault(c.row, []).append(c)
    non_empty_rows = sorted(r for r, cs in by_row.items() if any(c.raw_value is not None for c in cs))
    if explicit_header_row is not None:
        if explicit_header_row < 1:
            raise ValueError(...)
        header = explicit_header_row
        # 数据行：header 之后含非空单元格的行数（显式 header 无需该行本身非空）
        data_rows = sum(1 for r in non_empty_rows if r > header)
    else:
        if not non_empty_rows:
            return None, 0
        header = non_empty_rows[0]
        data_rows = sum(1 for r in non_empty_rows if r > header)
    return header, data_rows
```

