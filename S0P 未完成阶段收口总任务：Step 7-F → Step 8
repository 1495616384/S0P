def _read_sheet_cells(ws) -> List[CellRaw]:
    out = []
    if ws.max_row is None or ws.max_column is None or ws.max_row < 1 or ws.max_column < 1:
        return out
    for row in range(1, ws.max_row + 1):
        for col in range(1, ws.max_column + 1):
            cell = ws.cell(row=row, column=col)
            value = cell.value
            out.append(CellRaw(
                sheet=ws.title,
                row=row,
                col=col,
                raw_value=value,
                raw_text=raw_text_of(value),
                excel_address=f"{ws.title}!{get_column_letter(col)}{row}",
            ))
    return out
```

