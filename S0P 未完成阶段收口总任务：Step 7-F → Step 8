_FACTOR_TO_MM: dict[str, Decimal] = {
    "mm": Decimal("1"),
    "m": Decimal("1000"),
}

def get_quantity_kind(unit: str) -> Optional[str]:
    """unit → quantity_kind；未知单位返回 None（不猜测）。"""
    return UNIT_TO_QUANTITY.get(unit)

def to_decimal(value) -> Decimal:
    """int / float / str / Decimal → Decimal（float 经 str 转换，避免二进制误差）。"""
    if isinstance(value, Decimal):
        return value
    if isinstance(value, bool) or not isinstance(value, (int, float, str)):
        raise ValueError(f"无法转换为 Decimal 的数值类型：{type(value).__name__} = {value!r}")
    return Decimal(str(value))

def convert(value, from_unit: str, to_unit: str) -> Decimal:
    """同量纲换算（Decimal 精确，经基准 mm）。未知单位 / 量纲不一致 → ValueError。"""
    if from_unit not in _FACTOR_TO_MM:
        raise ValueError(f"未知单位 '{from_unit}'（第一版支持：{sorted(_FACTOR_TO_MM)}）")
    if to_unit not in _FACTOR_TO_MM:
        raise ValueError(f"未知单位 '{to_unit}'（第一版支持：{sorted(_FACTOR_TO_MM)}）")
    return to_decimal(value) * _FACTOR_TO_MM[from_unit] / _FACTOR_TO_MM[to_unit]
