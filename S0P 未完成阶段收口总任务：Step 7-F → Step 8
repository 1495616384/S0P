def _materialize_parts(parts: List[dict], by_id: Dict[str, Fact]) -> tuple[str, List[AnchorDeclaration]]:
    """Lit/Ref 序列 → (raw_text, anchor_declarations)（span 扩展见模块 docstring）。"""
    chunks: List[str] = []
    ref_spans: List[tuple[int, int, str, str]] = []  # (start, end, token, fact_id)
    pos = 0
    for part in parts:
        ptype = part.get("type")
        if ptype == "Lit":
            text = part["text"]
            chunks.append(text)
            pos += len(text)
        elif ptype == "Ref":
            fact = by_id.get(part["ref"])
            if fact is None:
                raise ValueError(f"adapter: Ref '{part['ref']}' 不在 fact_set 中——无法 materialize")
            text = _display_value(fact)
            ref_spans.append((pos, pos + len(text), text, part["ref"]))
            chunks.append(text)
            pos += len(text)
        else:
            raise ValueError(f"adapter: 不支持的 segment/cell 类型 '{ptype}'")
    raw_text = "".join(chunks)

    # span 扩展：与显示值相交的 tokenizer token 并入
    tokens = tokenize(raw_text)
    declarations: List[AnchorDeclaration] = []
    for start, end, token_text, fact_id in ref_spans:
        s, e = start, end
        for tok in tokens:
            if tok.char_start < e and tok.char_end > s:
                s = min(s, tok.char_start)
                e = max(e, tok.char_end)
        declarations.append(AnchorDeclaration(token=token_text, fact_id=fact_id, char_start=s, char_end=e))
    return raw_text, declarations
