status / revision / supersedes 转换，禁止发明（不得伪造 conflict → superseded）。
"""
from __future__ import annotations

from typing import List, Sequence

from cdm.types import Conflict, ConflictCandidate, SourceRef

def candidate_from(*, value, unit, quantity_kind, source_ref, method, provenance) -> ConflictCandidate:
    return ConflictCandidate(value=value, unit=unit, quantity_kind=quantity_kind, source_ref=source_ref, method=method, provenance=provenance)

def new_conflict(fact_id: str, candidates: Sequence[ConflictCandidate]) -> Conflict:
    if not fact_id:
        raise ValueError("Conflict.fact_id 必须非空")
    cands = list(candidates)
    if len(cands) < 2:
        raise ValueError(f"Conflict '{fact_id}' 至少需要 2 个候选值，得到 {len(cands)} 个")
    conf = Conflict(fact_id=fact_id, candidates=cands, resolution_policy="manual")
    if conf.resolved_by is not None or conf.resolution is not None:
        raise ValueError("第一版 Conflict 禁止带 resolved_by / resolution（裁决入口不提供）")
    return conf

def add_candidate(conflict: Conflict, candidate: ConflictCandidate) -> None:
    """去重追加（键 = value + unit + source_ref.location）。仅记录，不做裁决。"""
    for c in conflict.candidates:
