class TestNegativeUncertainty:
    """缺失 / 冲突输入的 E2E 路径（契约 §3.4：决定性负例）。

    - 缺失：mark_missing → fact.status=missing, value=None
      → evaluate → not_evaluable(gate:fact_status=missing)
      → conclude → insufficient_evidence（保留不确定性）
      → adapter 拒绝渲染 None（不静默补值）
    - 冲突：同 fact_id 不同值 → Conflict 记录（policy=manual）
      → 该 fact 不进 confirmed 集 → evaluate → not_evaluable(gate:fact_status=conflict)
      → conclude → insufficient_evidence
    """

    def test_missing_fact_retains_uncertainty_and_blocks_rendering(self) -> None:
        parse_result = parse_xlsx(FIXTURE_XLSX)
        candidates = map_cells_to_candidates(parse_result)
        domain = derive_domain_objects(candidates)

        store = FactStore(get_default_registry())
        store.ingest_candidates(candidates)
        for f in store.get_all_facts():
            if f.id != "fact:defect.D003.width":
                store.mark_confirmed(f.id)
        store.mark_missing("fact:defect.D003.width")

        facts = store.get_confirmed_facts()
        assert len(facts) == 27
        assert "fact:defect.D003.width" not in {f.id for f in facts}

        missing_fact = next(f for f in store.get_all_facts() if f.id == "fact:defect.D003.width")
        assert missing_fact.status == "missing" and missing_fact.value is None

        evaluations = [evaluate(f, WIDTH_CRITERION) for f in facts if f.fact_type == "defect.width"]
        evaluations.append(evaluate(missing_fact, WIDTH_CRITERION))
        assert {e.evaluation_id: e.status for e in evaluations}["eval-D003-width"] == "not_evaluable"

        conclusion = conclude(evaluations, defect_host_map=derive_defect_host_map(candidates))
        assert conclusion.status == "insufficient_evidence"

        # 渲染拒绝：missing fact（value=None）不得被静默补值
        report_ir = build(store.get_all_facts(), domain, conclusion)
        with pytest.raises(ValueError, match="缺失"):
            to_system_output(report_ir, store.get_all_facts(), evaluations=evaluations)
```

