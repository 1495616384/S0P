from __future__ import annotations

from pathlib import Path
from typing import List, Optional, Union

from openpyxl import load_workbook
from openpyxl.utils import get_column_letter

from cdm.types import RawSource

from .base import CellRaw, ParseResult, raw_text_of

def parse_xlsx(path, source_id=None, header_row=None) -> ParseResult:
    p = Path(path)
    wb = load_workbook(filename=str(p), data_only=True, read_only=False)
    try:
        sheets = list(wb.sheetnames)
        cells: List[CellRaw] = []
        first_sheet_cells: List[CellRaw] = []
        for si, name in enumerate(sheets):
            ws = wb[name]
            sheet_cells = _read_sheet_cells(ws)
            cells.extend(sheet_cells)
            if si == 0:
                first_sheet_cells = sheet_cells
    finally:
        wb.close()

    effective_header, data_rows = _analyze_header(first_sheet_cells, header_row)
    source = RawSource(
        source_id=source_id or p.name,
        source_type="xlsx",
        location=str(p),
        original_path=str(p),
        metadata={"sheet_names": sheets, "header_row": effective_header},
    )
    return ParseResult(raw_source=source, header_row=effective_header, data_rows=data_rows, cells=cells)
