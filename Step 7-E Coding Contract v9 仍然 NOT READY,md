### 5.4 Numeric Token Regex（Fix 4/5）

```python
# Fix 4: 尾部任何字母+符号表达式统一捕获为 raw_unit_candidate
# Fix 5: 可选 "±\s*" 前导（±3.2MPa / ± 3.2MPa）
# 指数后缀（×10ⁿ / ×10^n / e±n）并入 numeric_value
NUMERIC_TOKEN_RE = re.compile(
    rf'(?<![0-9A-Za-z])(±\s*)?([+-]?)(\d+(?:\.\d+)?)\s*'
    rf'(×10[⁰¹²³⁴⁵⁶⁷⁸⁹]+|×10\^-?\d+|[eE][+-]?\d+)?\s*([A-Za-zμ²³]+)?',
    re.UNICODE,
)

def parse_numeric_token(
    match: re.Match,
    unit_registry: UnitRegistrySnapshot,
) -> tuple[float, Optional[str], Optional[str], bool, bool]:
    """
    Returns:
        numeric_value, sign, parsed_unit, unit_resolution_failed, preceded_by_pm
    """
    preceded_by_pm = bool(match.group(1))          # Fix 5
    sign_str = match.group(2) or ""                 # "+" | "-" | ""
    mantissa_str = match.group(3)
    exponent_str = match.group(4) or ""
    raw_unit = match.group(5) or None               # Fix 4: 原始尾部字母表达式

    mantissa = float(mantissa_str)
    if exponent_str:
        if exponent_str.startswith("×10"):
            if exponent_str.startswith("×10^"):
                exp_num = int(exponent_str[4:])
            else:
                DIGIT_MAP = {"⁰":"0","¹":"1","²":"2","³":"3","⁴":"4","⁵":"5","⁶":"6","⁷":"7","⁸":"8","⁹":"9"}
                exp_digits = "".join(DIGIT_MAP.get(c, c) for c in exponent_str[3:])
                exp_num = int(exp_digits)
            mantissa *= 10 ** exp_num
        elif exponent_str.lower().startswith("e"):
            mantissa *= 10 ** int(exponent_str[1:])

    if sign_str == "-":
        mantissa = -mantissa

    # Fix 4: Unit resolution（禁止静默退化为 None）
    parsed_unit: Optional[str] = None
    unit_resolution_failed = False
    if raw_unit is not None:
        # 尝试在 Unit Registry 中查找（含最长匹配）
        if raw_unit in unit_registry.mapping:
            parsed_unit = raw_unit
        else:
            unit_resolution_failed = True
            parsed_unit = raw_unit                   # 保留原始字符串用于诊断

    return mantissa, sign_str or None, parsed_unit, unit_resolution_failed, preceded_by_pm
```

### 5.5 跨 kind overlap 冻结（Fix 3）

```python
def tokenize_rendered_segment(
    raw_text: str,
    segment_location: str,
    unit_registry: UnitRegistrySnapshot,
) -> list[TokenOccurrence]:
    candidates: list[TokenOccurrence] = []

    # Phase 1: numeric
    for m in NUMERIC_TOKEN_RE.finditer(raw_text):
        num_val, sign, unit, unit_fail, pm = parse_numeric_token(m, unit_registry)
        candidates.append(TokenOccurrence(
            segment_location=segment_location,
            char_start=m.start(),
            char_end=m.end(),
            token_text=m.group(0),
            token_kind="numeric",
            numeric_value=num_val,
            sign=sign,
            parsed_unit=unit,
            raw_unit_candidate=m.group(5) or None,
            unit_resolution_failed=unit_fail,
            preceded_by_pm=pm,
        ))

    # Phase 2: identifier
    for m in IDENTIFIER_TOKEN_RE.finditer(raw_text):
        candidates.append(TokenOccurrence(
            segment_location=segment_location,
            char_start=m.start(),
            char_end=m.end(),
            token_text=m.group(0),
            token_kind="identifier",
            normalized_identifier=parse_identifier_token(m),
        ))

    # Fix 3: Overlap resolution
    # Sort by: char_start ASC, -span_length DESC, identifier(0) > numeric(1)
    candidates.sort(key=lambda t: (
        t.char_start,
        -(t.char_end - t.char_start),
        0 if t.token_kind == "identifier" else 1,
    ))

    accepted: list[TokenOccurrence] = []
    accepted_spans: list[tuple[int, int]] = []
    for cand in candidates:
        cs, ce = cand.char_start, cand.char_end
        overlap = any(cs < ae and ce > as_ for (as_, ae) in accepted_spans)
        if not overlap:
            accepted.append(cand)
            accepted_spans.append((cs, ce))

    accepted.sort(key=lambda t: (t.char_start, t.char_end))
    return accepted
```

**Fix 3 冻结语义验证**：

| 输入 | candidates | 排序后 | 最终结果 |
|---|---|---|---|
| `S-3` | identifier S-3(0,3) + numeric "3"(2,3) | S-3 先（span 更长） | identifier S-3（numeric 被抑制） |
| `ST001` | identifier ST001(0,5) + numeric "001"(2,5) | ST001 先 | identifier ST001（无独立 "T001"，"001" 被抑制） |

